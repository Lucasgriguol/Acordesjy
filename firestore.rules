rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Canciones: lectura pública, escritura para usuarios autenticados
    // (incluye anónimos). El filtro real es el código del cliente.
    match /songs/{songId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Repertorios: igual criterio
    match /repertoires/{setId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Favoritos: cada usuario solo accede a su propio documento
    match /favorites/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}